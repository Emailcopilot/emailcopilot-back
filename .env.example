# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"
# Public API URL used for OAuth redirect_uri
OAUTH_REDIRECT_BASE="http://localhost:3001"

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN="http://localhost:3000"

# ─── Secrets ──────────────────────────────────────────────────────────────────
# openssl rand -hex 32
ENCRYPTION_KEY=""

# ─── Clerk ────────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""

# ─── Mollie ───────────────────────────────────────────────────────────────────
MOLLIE_API_KEY=""

# ─── Email OAuth (Gmail / Outlook) ────────────────────────────────────────────
# Google Cloud Console → OAuth client → redirect:
#   {OAUTH_REDIRECT_BASE}/email-accounts/oauth/gmail/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Entra app registration → redirect:
#   {OAUTH_REDIRECT_BASE}/email-accounts/oauth/outlook/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
